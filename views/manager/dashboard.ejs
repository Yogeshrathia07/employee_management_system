<%- include('../partials/head', {title: 'Manager Dashboard'}) %>
<div class="app-layout">
  <%- include('../partials/sidebar-manager') %>
  <div class="main-content">
    <header class="page-header">
      <div class="flex items-center gap-3">
        <button class="mobile-menu-btn" onclick="openSidebar()"><i class="bx bx-menu"></i></button>
        <div>
          <div class="page-title">Manager Dashboard</div>
          <div class="page-subtitle">Team overview and pending actions</div>
        </div>
      </div>
      <div class="header-actions"></div>
    </header>
    <div class="page-body admin-employees-page employee-shared-page">
      <div class="employee-directory-shell employee-dashboard-shell">
        <div id="notif-area"></div>

        <div class="employee-overview-grid employee-dashboard-grid">
          <a href="/manager/profile" class="employee-overview-card employee-overview-nav highlight-gray">
            <div class="employee-overview-head">
              <div class="employee-overview-icon gray"><i class="bx bxs-user-circle"></i></div>
              <div>
                <div class="employee-overview-label">My Profile</div>
              </div>
            </div>
            <div class="employee-overview-link">Open Profile</div>
          </a>

          <a href="/manager/tasks" class="employee-overview-card employee-overview-nav highlight-blue">
            <div class="employee-overview-head">
              <div class="employee-overview-icon blue"><i class="bx bxs-check-square"></i></div>
              <div>
                <div class="employee-overview-label">Assign Tasks</div>
                <div class="employee-overview-pending" data-pending-wrap="tasks"><span data-pending="tasks">–</span> waiting</div>
              </div>
            </div>
            <div class="employee-overview-link">Open Task Management</div>
          </a>

          <a href="/manager/leaves" class="employee-overview-card employee-overview-nav highlight-orange">
            <div class="employee-overview-head">
              <div class="employee-overview-icon orange"><i class="bx bxs-calendar-check"></i></div>
              <div>
                <div class="employee-overview-label">Leave Requests</div>
                <div class="employee-overview-pending" data-pending-wrap="leaves"><span data-pending="leaves">–</span> waiting</div>
              </div>
            </div>
            <div class="employee-overview-link emphasis">Review Leave Requests</div>
          </a>

          <a href="/manager/timesheets" class="employee-overview-card employee-overview-nav highlight-green">
            <div class="employee-overview-head">
              <div class="employee-overview-icon green"><i class="bx bxs-calendar"></i></div>
              <div>
                <div class="employee-overview-label">Timesheets</div>
                <div class="employee-overview-pending" data-pending-wrap="timesheets"><span data-pending="timesheets">–</span> waiting</div>
              </div>
            </div>
            <div class="employee-overview-link">Review Timesheets</div>
          </a>

          <a href="/manager/documents" class="employee-overview-card employee-overview-nav highlight-purple">
            <div class="employee-overview-head">
              <div class="employee-overview-icon purple"><i class="bx bxs-file-doc"></i></div>
              <div>
                <div class="employee-overview-label">Team Documents</div>
                <div class="employee-overview-pending" data-pending-wrap="documents"><span data-pending="documents">–</span> waiting</div>
              </div>
            </div>
            <div class="employee-overview-link">Open Team Documents</div>
          </a>

          <a href="/manager/my-documents" class="employee-overview-card employee-overview-nav highlight-gray">
            <div class="employee-overview-head">
              <div class="employee-overview-icon gray"><i class="bx bx-file"></i></div>
              <div>
                <div class="employee-overview-label">My Documents</div>
              </div>
            </div>
            <div class="employee-overview-link">Upload Personal Documents</div>
          </a>

          <a href="/manager/leave-calendar" class="employee-overview-card employee-overview-nav highlight-gray">
            <div class="employee-overview-head">
              <div class="employee-overview-icon gray"><i class="bx bxs-calendar"></i></div>
              <div>
                <div class="employee-overview-label">Leave Calendar</div>
              </div>
            </div>
            <div class="employee-overview-link">Open Leave Calendar</div>
          </a>

          <a href="/manager/policies" class="employee-overview-card employee-overview-nav highlight-gray">
            <div class="employee-overview-head">
              <div class="employee-overview-icon gray"><i class="bx bxs-book-content"></i></div>
              <div>
                <div class="employee-overview-label">Company Policy</div>
              </div>
            </div>
            <div class="employee-overview-link">Open Policies</div>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/api.js"></script>
<script>
async function loadDashboard() {
  try {
    const notifs = await api('GET', '/notifications');
    const activeNotifs = (notifs || []).filter(function(n) { return n.status === 'active'; });
    if (activeNotifs.length) {
      document.getElementById('notif-area').innerHTML = activeNotifs.map(function(n) {
        return '<div class="notif-banner">' +
          '<div class="notif-banner-icon"><i class="bx bxs-megaphone"></i></div>' +
          '<div class="notif-banner-content">' +
            '<div class="notif-banner-title">' + escapeHtml(n.title) + '</div>' +
            '<div class="notif-banner-msg">' + escapeHtml(n.message || '') + '</div>' +
          '</div>' +
          (n.filePath ? '<div class="notif-banner-actions"><button class="notif-banner-btn" onclick="window.open(\'/api/notifications/' + Number(n.id) + '/download?token=\'+encodeURIComponent(getToken()),\'_blank\')"><i class="bx bx-download"></i> Download</button></div>' : '') +
        '</div>';
      }).join('');
    }
  } catch (e) {
    toast(e.message, 'error');
  }
}

// What is waiting for this manager: team requests to review and work given to them.
async function loadPending() {
  const get = url => api('GET', url).catch(() => null);
  const [leaves, timesheets, documents, review, mine] = await Promise.all([
    get('/leaves?scope=team'), get('/timesheets?scope=team'), get('/documents?scope=team'),
    get('/tasks?scope=assigned_by_me'), get('/tasks?scope=assigned_to_me'),
  ]);
  const count = (list, test) => Array.isArray(list) ? list.filter(test).length : null;
  const openForMe = t => t.status !== 'done' && !['approved', 'refused', 'pending_approval'].includes(t.approvalStatus);
  const tasks = review && mine
    ? count(review, t => t.approvalStatus === 'pending_approval') + count(mine, openForMe)
    : null;
  const pending = {
    leaves: count(leaves, l => l.status === 'pending'),
    timesheets: count(timesheets, t => t.status === 'pending'),
    documents: count(documents, d => (d.verificationStatus || 'pending') === 'pending'),
    tasks,
  };
  Object.keys(pending).forEach(function(key) {
    const n = pending[key];
    const wrap = document.querySelector('[data-pending-wrap="' + key + '"]');
    if (!wrap) return;
    wrap.querySelector('[data-pending]').textContent = n === null ? '–' : String(n);
    wrap.classList.toggle('has-items', n > 0);
  });
}

loadDashboard();
loadPending();
</script>
</body></html>
