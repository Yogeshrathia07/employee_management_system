# Copy this file to .env on cPanel and replace every placeholder with production values.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanel_database_name
DB_USER=your_cpanel_database_user
DB_PASS=your_cpanel_database_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace_with_a_strong_password
